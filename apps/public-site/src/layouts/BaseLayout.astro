---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
}

const { title, description, canonicalPath = "/" } = Astro.props;
const isSiteRelativePath = canonicalPath.startsWith("/") && !canonicalPath.startsWith("//") && !canonicalPath.includes("\\");
const canonical = new URL(isSiteRelativePath ? canonicalPath : "/", Astro.site).toString();
---
<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="index, follow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="The Tennis Plan" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
  </head>
  <body><slot /></body>
  <script>
    import { appRedirectUrl } from "../scripts/legacyHashRedirect.mjs";

    const destination = appRedirectUrl({
      hash: window.location.hash,
      search: window.location.search,
      cookie: document.cookie,
    });
    if (destination) window.location.replace(destination);
  </script>
</html>
