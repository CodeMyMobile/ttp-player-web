---
import { CONTACT_EMAIL } from "../lib/site";
import { loginHref } from "../lib/appLinks";

interface Props {
  /**
   * Use the landing page's wider shell. The landing page lays out at 1440px and the
   * directory at 1180px, so one fixed shell would leave the footer visibly narrower than
   * the content above it on whichever page it did not belong to.
   */
  wide?: boolean;
}
const { wide = false } = Astro.props;
const shell = wide ? "landing-container" : "directory-shell";

/**
 * The one footer, on every page.
 *
 * Before this there was no shared footer: a `<footer>` lived inside CommunityCta, which
 * only the landing page renders, so the hub, the area pages and all 23 profiles ended on a
 * CTA band with nothing after them — which is why /about was reachable from exactly one
 * button. That footer is now this one, so the two cannot drift apart.
 */
const year = 2026;
---
<footer class="site-footer">
  <div class:list={[shell, "site-footer__inner"]}>
    <a class="site-footer__brand" href="/">The Tennis <span>Plan</span></a>
    <nav class="site-footer__links" aria-label="Footer navigation">
      <a href="/tennis-coaches">Tennis coaches</a>
      <a href="/about">About</a>
      <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
      <a href={loginHref()}>Sign in</a>
    </nav>
    <p class="site-footer__fine">© {year} The Tennis Plan · Coaching across West Los Angeles</p>
  </div>
</footer>
