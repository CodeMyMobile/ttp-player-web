---
import { loginHref } from "../lib/appLinks";

interface Props {
  /**
   * In-app path to land on after signing in. Omit on pages where the dashboard is the
   * right destination — the landing page passes nothing, the coach pages pass a coach
   * surface, so a visitor who signs in there does not get dropped further from what they
   * were doing than where they started.
   */
  next?: string;
}
const { next } = Astro.props;
const href = loginHref(next);
---
<header class="landing-nav">
  <div class="landing-container landing-nav__inner">
    <a class="landing-brand" href="/" aria-label="The Tennis Plan — home">
      The Tennis <span class="landing-brand__accent">Plan</span>
    </a>
    <nav class="landing-nav__actions" aria-label="Primary navigation">
      <a class="landing-link" href={href}>Sign in</a>
      <a class="landing-btn landing-btn--primary" href={href}>Get started</a>
    </nav>
  </div>
</header>
