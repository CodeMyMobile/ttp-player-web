---
import type { Coach } from "../lib/coaches";
import { areaLabel } from "../lib/venues";

interface Props { coach: Coach; }
const { coach } = Astro.props;
const initials = coach.name.split(/\s+/).map((word) => word[0]).join("").slice(0, 2).toUpperCase();
const courts = coach.courts.slice(0, 3).map((court) => court.name);
const primaryArea = coach.areas[0] ? areaLabel(coach.areas[0]) : "West Los Angeles";
---
<article class="coach">
  <div class="coach-top">
    {/* Initials sit underneath; the photo covers them. onerror removes a photo that
        fails to load so the initials show through — every photo_url on the roster is
        non-null, so a missing image here is a dead URL rather than absent data, and
        without this the card renders alt text in a 64px box. Empty alt because the
        name is already the adjacent heading: to a screen reader this image carries
        nothing the coach's own name does not. */}
    <div class="coach-avatar" aria-hidden="true">
      {initials}
      {coach.photo && (
        <img
          src={coach.photo}
          alt=""
          width="64"
          height="64"
          loading="lazy"
          decoding="async"
          onerror="this.remove()"
        />
      )}
    </div>
    <div class="coach-id">
      <h3><a href={`/coaches/${coach.slug}`}>{coach.name}</a></h3>
      {/* The badge is decorative and the words carry the claim. "Tennis Plan Verified"
          stays real text on the meta line so it is indexable and readable aloud; the
          mark beside it is aria-hidden rather than being the only carrier of meaning,
          which is what a bare ✓ with an aria-label was. */}
      <p>
        <span class="coach-verified">
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor" width="13" height="13">
            <path d="M12 1.6l2.2 2 3-.2.9 2.9 2.6 1.5-1 2.8 1 2.8-2.6 1.5-.9 2.9-3-.2-2.2 2-2.2-2-3 .2-.9-2.9L3.3 14l1-2.8-1-2.8 2.6-1.5.9-2.9 3 .2z" />
            <path d="M10.8 15.5l-3-3 1.4-1.4 1.6 1.6 4-4L16.2 10z" fill="#ECFAF0" />
          </svg>Tennis Plan Verified</span> · {primaryArea}{coach.students !== null && ` · ${coach.students} students`}
      </p>
    </div>
    <div class="coach-rate">
      {coach.privateRate !== null && <><b>${coach.privateRate}</b><small>private</small></>}
      {coach.groupRate !== null && <em>${coach.groupRate} group</em>}
    </div>
  </div>
  <p class="coach-bio">{coach.excerpt}</p>
  {/* focus_areas is empty for all 46 coaches on /public/coaches today — the data
      exists as `specialties` on /public/coaches/search and is not mapped across.
      Rendering conditionally means this lights up when that lands, with no change
      here. Capped in the data layer so a coach with ten does not fill the card. */}
  {coach.focus.length > 0 && <p class="coach-detail"><b>Focus</b><span>{coach.focus.join(", ")}</span></p>}
  {/* formats is the best-covered of the fields missing from /public/coaches — 31/31 on
      /public/coaches/search against 16/31 for specialties — and it answers "can I book
      the kind of session I want", which a specialty list does not. Conditional, so it
      lights up when the endpoint maps it across. */}
  {coach.formats.length > 0 && <p class="coach-detail"><b>Formats</b><span>{coach.formats.join(" · ")}</span></p>}
  {/* No label word. "Courts" in front of a list of court names is the only label on the
      card that restates what the value obviously is, and dropping it buys the names the
      full width. The wash background does the work the label was doing — marking the row
      as a different kind of thing from the bio above it. */}
  {courts.length > 0 && (
    <p class="coach-courts-row">
      {courts.join(", ")}
      {coach.courts.length > 3 && <span class="coach-more"> +{coach.courts.length - 3} more</span>}
    </p>
  )}
  <div class="coach-actions">
    <a class="coach-button coach-button--primary" href={`/coaches/${coach.slug}`}>View profile</a>
    <a class="coach-button" href={`https://app.thetennisplan.com/#/?redirect=coach/${coach.slug}&action=book`}>Book</a>
  </div>
</article>
