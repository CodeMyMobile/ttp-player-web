---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ClassDirectory from "../../components/ClassDirectory.astro";
import { loginHref } from "../../lib/appLinks";
import { AREAS, classAreas, classSchema, getPublicClasses } from "../../lib/whatsOn";

const classes = await getPublicClasses();
const areas = classAreas(classes);
const labelOf = (id: string) => AREAS.find(([key]) => key === id)?.[1] ?? id;

const areaNames = areas.map(labelOf);
const areaSentence =
  areaNames.length > 1
    ? `${areaNames.slice(0, -1).join(", ")} and ${areaNames[areaNames.length - 1]}`
    : (areaNames[0] ?? "West Los Angeles");

const prices = classes
  .map((item) => Number(item.p.replace(/[^0-9.]/g, "")))
  .filter((value) => Number.isFinite(value) && value > 0);
const priceRange = prices.length
  ? `$${Math.min(...prices)}-$${Math.max(...prices)}`
  : null;

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "Group tennis lessons in West Los Angeles",
    itemListElement: classes.map((item, index) => ({
      "@type": "ListItem",
      position: index + 1,
      item: classSchema(item),
    })),
  },
];
---

<BaseLayout
  title="Group Tennis Lessons in West Los Angeles | The Tennis Plan"
  description="Browse group tennis lessons, clinics and liveball across West LA. See the level, coach, court and price before you book — no account needed."
  canonicalPath="/group-tennis-lessons"
  schema={schema}
>
  <Header next="/group-lessons" />
  <main class="class-directory">
    <section class="class-hero">
      <div class="directory-shell">
        <span><b>{classes.length}</b> classes scheduled · no account needed to look</span>
        <h1>Group tennis lessons in West Los Angeles</h1>
        <p class="class-promise">
          Clinics, drills and liveball run by coaches we know. Every class shows its level, court
          and price before you book.
        </p>
        {/* "including", because two of the courts sit in areas the filter list
            does not name — the sentence must not contradict the cards below it. */}
        {areas.length > 0 && <p>Classes run across West LA, including {areaSentence}.</p>}
      </div>
    </section>

    <ClassDirectory classes={classes} areas={areas} />

    <section class="class-faq">
      <div class="directory-shell">
        <h2>Before you book</h2>
        <dl>
          <dt>What does a group tennis lesson cost?</dt>
          <dd>
            {priceRange
              ? `Classes on this page run ${priceRange} per player. Each coach sets their own price, and it is shown on every class.`
              : "Each coach sets their own price, and it is shown on every class."}
          </dd>
          <dt>What level do I need to be?</dt>
          <dd>
            Most classes state an NTRP level, shown on the card. It is a guide rather than a
            test — the coach makes the final call after the first session. If you are not sure
            of your level, <a href="/what-is-my-tennis-level">take the two-minute quiz</a>.
          </dd>
          <dt>Do I need an account to browse?</dt>
          <dd>
            No. Every class, coach, court and price here is public. You only need an account to
            book a place.
          </dd>
          <dt>Can I cancel?</dt>
          <dd>
            Yes — free cancellation up to 24 hours before the class starts, counted against the
            clock at the court.
          </dd>
          <dt>How often do classes run?</dt>
          <dd>
            Many are weekly. Where a class has more than one date on the schedule, its card says
            how many.
          </dd>
        </dl>
      </div>
    </section>

    <section class="class-cta">
      <div class="directory-shell">
        <h2>Found a class?</h2>
        <p>Create an account to book a place, pay, and keep every session in one place.</p>
        <a class="class-button class-button--primary" href={loginHref("/group-lessons")}>Create your account</a>
        <a class="class-button" href={loginHref("/group-lessons")}>Sign in</a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style is:global>
  .class-directory { color: #12141c; font-family: Inter, ui-sans-serif, system-ui, sans-serif; }
  .class-hero { padding: 40px 0 18px; background: #f7f8fb; }
  .class-hero span { display: inline-block; margin-bottom: 12px; font-size: 0.84rem; color: #667085; }
  .class-hero span b { color: #12141c; }
  .class-hero h1 { margin: 0 0 12px; font-size: clamp(1.9rem, 5vw, 2.7rem); font-weight: 800; letter-spacing: -0.03em; line-height: 1.12; }
  .class-hero p { margin: 0 0 6px; font-size: 1.02rem; color: #40465a; max-width: 62ch; }
  .class-hero .class-promise { font-weight: 600; color: #12141c; }

  .class-faq { padding: 8px 0 52px; border-top: 1px solid #e4e7ec; }
  .class-faq h2 { margin: 32px 0 18px; font-size: 1.5rem; font-weight: 800; letter-spacing: -0.02em; }
  .class-faq dt { margin-top: 18px; font-size: 1rem; font-weight: 700; }
  .class-faq dd { margin: 6px 0 0; font-size: 0.95rem; color: #40465a; max-width: 68ch; }

  .class-cta { padding: 44px 0 64px; background: #f7f8fb; }
  .class-cta h2 { margin: 0 0 8px; font-size: 1.5rem; font-weight: 800; letter-spacing: -0.02em; }
  .class-cta p { margin: 0 0 18px; color: #40465a; }
  .class-button { display: inline-block; margin-right: 10px; padding: 12px 18px; border: 1px solid #e4e7ec; border-radius: 12px; background: #fff; color: #40465a; font-size: 0.94rem; font-weight: 600; text-decoration: none; }
  .class-button--primary { border-color: #7c5cf5; background: #7c5cf5; color: #fff; }
</style>
