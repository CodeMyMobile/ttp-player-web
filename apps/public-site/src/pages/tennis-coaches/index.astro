---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import CoachDirectory from "../../components/CoachDirectory.astro";
import { getAreaCoaches, getCoaches } from "../../lib/coaches";
import { areaLabel } from "../../lib/venues";
const coaches = await getCoaches();
// Ordered by coach count, strongest area first, so the chips and the courts section both
// lead with the neighbourhoods we actually cover deeply. Alphabetical breaks ties, which
// matters because the Map's own key order is coach-iteration order — it reshuffles
// whenever the roster changes, and the chips would move between builds for no reason.
const areaCoaches = getAreaCoaches(coaches);
const areas = [...areaCoaches.keys()].sort(
  (a, b) =>
    (areaCoaches.get(b)?.length ?? 0) - (areaCoaches.get(a)?.length ?? 0) ||
    areaLabel(a).localeCompare(areaLabel(b)),
);
const courtsByArea = new Map(areas.map((area) => [area, [...new Set(coaches.filter((coach) => coach.areas.includes(area)).flatMap((coach) => coach.courts.filter((court) => court.area === area).map((court) => court.name)))]]));
/**
 * The hero sentence lists the areas that actually have coaches, in the order the chips
 * render them. It was hardcoded to six while the chips showed nine, and the two drifted
 * the moment the roster changed. Oxford-comma-free "A, B and C" to match the prose.
 */
// Spelled out because it reads as prose, not as a statistic — the panel below carries the
// numerals. Falls back to the digits past the point where a roster this size could reach.
const NUMBER_WORDS = ["zero", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten", "eleven", "twelve"];
const spellNumber = (value: number) => NUMBER_WORDS[value] ?? String(value);

const areaNames = areas.map((area) => areaLabel(area));
const areaSentence =
  areaNames.length > 1
    ? `${areaNames.slice(0, -1).join(", ")} and ${areaNames[areaNames.length - 1]}`
    : (areaNames[0] ?? "West Los Angeles");

const schema = [{ "@context": "https://schema.org", "@type": "ItemList", name: "Tennis coaches in West Los Angeles", itemListElement: coaches.map((coach, index) => ({ "@type": "ListItem", position: index + 1, url: `https://thetennisplan.com/coaches/${coach.slug}` })) }, { "@context": "https://schema.org", "@type": "LocalBusiness", name: "The Tennis Plan", url: "https://thetennisplan.com", areaServed: areas.map((area) => ({ "@type": "Place", name: areaLabel(area) })) }];
---
<BaseLayout title="Tennis Coaches in West Los Angeles | The Tennis Plan" description="Browse invite-only tennis coaches across West Los Angeles. Compare rates and courts — no account needed." canonicalPath="/tennis-coaches" schema={schema}>
  <Header />
  <main class="coach-directory">
    <section class="coach-hero"><div class="directory-shell"><span><b>{coaches.length}</b> invited coaches · no open sign-ups</span><h1>Tennis coaches in West Los Angeles you can trust</h1><p class="coach-promise">Not a directory. Every coach here is someone we know and would book ourselves.</p><p>Browse rates and courts across {spellNumber(areas.length)} West LA neighbourhoods — no account needed.</p></div></section>
    <section class="coach-strip"><div class="directory-shell">Invite-only. Coaches can't add themselves.</div></section>
    <CoachDirectory coaches={coaches} areas={areas} />
    <section class="coach-vetting"><div class="directory-shell"><h2>How we choose coaches</h2><p>The roster is closed. It grows when we meet a coach worth adding, and not before.</p><ul><li><b>We reach out first</b><span>There's no application form and no way to add yourself. Every coach here got an invitation from us.</span></li><li><b>We've seen them coach</b><span>Someone at The Tennis Plan has hit with each coach or watched them run a lesson before the invitation went out.</span></li><li><b>Tennis Plan Verified</b><span>The badge means we've confirmed identity, courts, and listed credentials — not that they filled in a profile.</span></li><li><b>Someone vouched by name</b><span>Every coach traces back to a person who put their own reputation behind the recommendation.</span></li></ul></div></section>
    <section class="coach-about"><div class="directory-shell coach-about-grid"><div><h2>Why this exists</h2><p>The Tennis Plan was built by coaches who teach in West LA — on the courts at Penmar, Mar Vista Recreation Center and Culver City High School, week in and week out, with the players who live around them.</p><p>Finding a good coach between Santa Monica and Culver City has always meant asking around at the courts and hoping. The coaches were out there. The hard part was knowing which ones were worth your time. So we made the list we wished existed.</p><p>Every coach here is someone we've played with, watched teach, or been coached by. If we wouldn't book them ourselves, they're not on it — and the list stays short because of it.</p><p>Covering {areaSentence}.</p></div><aside><p><b>{coaches.length}</b> coaches</p><p><b>{new Set(coaches.flatMap((coach) => coach.areas)).size}</b> West LA neighbourhoods</p><p><b>0</b> open sign-ups</p><a class="coach-button coach-button--primary" href="/about">More about us</a></aside></div></section>
    <section class="coach-courts"><div class="directory-shell"><h2>Where our coaches teach</h2><p>Most lessons happen on public courts across the Westside. Court fees and reservation rules vary by facility — your coach will tell you what to expect before your first session.</p><div class="court-grid">{areas.map((area) => <article><h3><a href={`/tennis-coaches/${area}`}>{areaLabel(area)}</a></h3><ul>{courtsByArea.get(area)?.map((court) => <li>{court}</li>)}</ul><p>{coaches.filter((coach) => coach.areas.includes(area)).length} coaches</p></article>)}</div></div></section>
    <section class="coach-faq"><div class="directory-shell"><h2>Before you book</h2><dl><dt>What do tennis lessons cost in West LA?</dt><dd>Coaches here charge between $85 and $160 an hour for private lessons. Group and liveball sessions usually run around $50 per player. Rates are set by each coach and shown on their profile.</dd><dt>Do I need an account to browse?</dt><dd>No. Every coach profile, rate and court is public. You only need an account to book a lesson or message a coach.</dd><dt>Who pays for the court?</dt><dd>Most lessons run on public courts at city recreation centers and school facilities. Some are free, some charge an hourly fee, and a few need a reservation in advance. Your coach will tell you which applies before the first session.</dd><dt>How are coaches vetted?</dt><dd>There is no application form. Every coach on this page was invited by someone at The Tennis Plan who had already hit with them or watched them run a lesson.</dd><dt>How is this different from CoachUp or a general marketplace?</dt><dd>On most platforms, coaches create their own listings and the details are self-reported. Here the list is short on purpose.</dd><dt>Do coaches travel to my court?</dt><dd>Many do. Coaches list a primary court plus other facilities they regularly teach at — check the profile, or ask when you book.</dd></dl></div></section>
    <section class="coach-cta"><div class="directory-shell"><h2>Found someone?</h2><p>Create an account to book a lesson, buy a package, and keep every session in one place.</p><a class="coach-button coach-button--primary" href="https://app.thetennisplan.com/#/login">Create your account</a> <a class="coach-button" href="https://app.thetennisplan.com/#/login">Sign in</a></div></section>
  </main>
</BaseLayout>
