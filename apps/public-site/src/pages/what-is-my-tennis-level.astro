---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { CONTACT_EMAIL } from "../lib/site";

const contactEmail = CONTACT_EMAIL;

const title = "What's My Tennis Level? Free NTRP Rating Quiz | The Tennis Plan";
// No question count in the copy: the paths are different lengths — the beginner
// answer exits early, declaring a USTA rating short-circuits the scoring — so any
// fixed number is wrong on most of them. "About a minute" is true on all.
const description =
  "Get an honest NTRP estimate in about a minute. No account, no email needed.";

interface QuizOption {
  id: string;
  label: string;
  detail?: string;
}

interface QuizQuestion {
  key: string;
  prompt: string;
  hint: string;
  branch?: boolean;
  options: QuizOption[];
}

const quizQuestions: QuizQuestion[] = [
  {
    key: "pool",
    prompt: "Which do you play?",
    hint: "NTRP is calibrated separately for men's and women's play, so this genuinely changes the answer.",
    options: [
      { id: "m", label: "Men's" },
      { id: "w", label: "Women's" },
    ],
  },
  {
    key: "bg",
    prompt: "How much competitive tennis have you played?",
    hint: "The single biggest clue to your level.",
    options: [
      { id: "starting", label: "I'm just starting out", detail: "New to tennis, or played a handful of times" },
      { id: "social", label: "Not really: social and rec", detail: "Hitting with friends, drop-in play" },
      { id: "lessons", label: "Lessons or clinics regularly", detail: "Group lessons, cardio tennis" },
      { id: "team", label: "High school or club team", detail: "Organized team matches" },
      { id: "usta", label: "USTA league or tournaments", detail: "You already have a rating" },
      { id: "college", label: "College varsity or higher", detail: "NCAA, ITF, satellite or pro" },
    ],
  },
  {
    key: "usta",
    prompt: "What NTRP rating do you play at?",
    hint: "We'll take your word for it. It beats anything we'd estimate.",
    branch: true,
    options: [
      { id: "u30", label: "3.0" },
      { id: "u35", label: "3.5" },
      { id: "u40", label: "4.0" },
      { id: "u45", label: "4.5" },
      { id: "u50", label: "5.0 and above" },
    ],
  },
  {
    key: "freq",
    prompt: "How often are you playing right now?",
    hint: "Current form counts for more than peak form.",
    options: [
      { id: "f3", label: "Three or more times a week" },
      { id: "f2", label: "Once or twice a week" },
      { id: "f1", label: "A few times a month" },
      { id: "f0", label: "Coming back after time off", detail: "We'll factor in the rust" },
    ],
  },
  {
    key: "serve",
    prompt: "Your second serve",
    hint: "This is where levels separate most clearly.",
    options: [
      { id: "s0", label: "Getting it in is the goal", detail: "Double faults happen" },
      { id: "s1", label: "Safe and reliable, not much spin", detail: "Rarely double fault, easy to attack" },
      { id: "s2", label: "A spin serve I trust at 30-40", detail: "It holds up under pressure" },
      { id: "s3", label: "A weapon I can place", detail: "I win free points on serve" },
    ],
  },
  {
    key: "rally",
    prompt: "In a baseline rally",
    hint: "Think about your normal weekly opponents.",
    options: [
      { id: "r0", label: "I focus on getting it back" },
      { id: "r1", label: "I can keep a crosscourt rally going" },
      { id: "r2", label: "I direct the ball on purpose", detail: "Change direction, find the open court" },
      { id: "r3", label: "I construct points and handle real pace" },
    ],
  },
];

/**
 * Where and when, asked after the result rather than as questions six and seven.
 *
 * The ids are what travel; the labels are what people read. A display string in a
 * URL is a string that breaks the moment the copy is edited, and these ids are
 * about to be read by the destination page.
 */
const areas = [
  { id: "mar-vista", label: "Mar Vista" },
  { id: "santa-monica", label: "Santa Monica" },
  { id: "culver-city", label: "Culver City" },
  { id: "venice", label: "Venice" },
  { id: "westwood", label: "Westwood" },
  { id: "somewhere-else", label: "Somewhere else" },
];

const times = [
  { id: "mornings", label: "Mornings" },
  { id: "evenings", label: "Evenings" },
  { id: "weekends", label: "Weekends" },
];

/**
 * The served first card shows a count, and it has to agree with what the script
 * computes once it takes over. Derived rather than written out: "1 of 5" was left
 * behind when this question set changed, and the page shipped saying five.
 *
 * The default path is every non-branching question — declaring a USTA rating is
 * the only thing that opens the branch.
 */
const defaultPathLength = quizQuestions.filter((question) => !question.branch).length;
const initialProgress = Math.round((1 / defaultPathLength) * 100);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Is NTRP the same as UTR?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "No. NTRP runs 1.0 to 7.0 in half steps and is the standard for US league play. UTR runs 1 to 16.5 and is calculated from match results.",
      },
    },
    {
      "@type": "Question",
      name: "Is a women's 4.0 the same as a men's 4.0?",
      acceptedAnswer: {
        "@type": "Answer",
        // Identical to the visible answer in the FAQ below — marked-up text that does
        // not match what the page shows is a structured-data violation, not a nicety.
        text: "On paper the NTRP descriptions are identical. In practice the two scales are calibrated against different populations, because USTA ratings come out of league play that's separated by gender, and there's no official conversion between them. That's why we ask which you play before estimating rather than after.",
      },
    },
    {
      "@type": "Question",
      name: "How accurate is a tennis self-rating?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Less accurate than most players expect, particularly between 3.0 and 4.0. Asking about playing history and results is more reliable than asking players to pick a flattering description.",
      },
    },
    {
      "@type": "Question",
      name: "Do I need an account?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "No account is needed to take the quiz or see the result. You only need one if you want to save the level and use it in The Tennis Plan app.",
      },
    },
  ],
};
---

<BaseLayout {title} {description} canonicalPath="/what-is-my-tennis-level" schema={faqSchema}>
  <div class="level-page">
    <Header />
    <main id="main">
      <section class="level-hero">
        <div class="level-hero__image" aria-hidden="true"></div>
        <div class="level-shell level-hero__inner">
          <div class="level-copy">
            <p class="level-eyebrow">Free NTRP quiz</p>
            <h1>What's my tennis level?</h1>
            <p>
              About a minute, no account. Get a practical NTRP estimate you can use to
              choose better matches, classes, leagues, and coaches.
            </p>
            <div class="level-proof" aria-label="Quiz promises">
              <span>About a minute</span>
              <span>No email</span>
              <span>Half-level band</span>
            </div>
          </div>

          <section class="level-quiz quiz" id="quiz" aria-labelledby="quiz-title">
            <div class="qhead">
              <button class="qback" type="button" aria-label="Back" disabled>
                <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
              </button>
              <span class="qbar"><i style={`width: ${initialProgress}%`}></i></span>
              <span class="qcount">1 of {defaultPathLength}</span>
            </div>
            <h2 class="qz-q" id="quiz-title" data-question-key={quizQuestions[0].key}>{quizQuestions[0].prompt}</h2>
            <p class="qz-h">{quizQuestions[0].hint}</p>
            <div class="qopts">
              {quizQuestions[0].options.map((option) => (
                <button class="qopt" type="button" data-option-id={option.id}>
                  <b>{option.label}</b>
                  {option.detail && <small>{option.detail}</small>}
                </button>
              ))}
            </div>
            <div class="qskip"><button type="button" data-skip-to-usta>I already know my level</button></div>
          </section>
        </div>
      </section>

      <section class="level-section level-section--levels">
        <div class="level-shell">
          <div class="level-section__head">
            <p class="level-eyebrow">NTRP, briefly</p>
            <h2>The adult rec levels most players mean</h2>
          </div>
          <div class="level-grid">
            <article><b>2.0-2.5</b><span>Newer player building rally control and serve basics.</span></article>
            <article><b>3.0</b><span>Can rally and start points reliably, but pace and placement vary.</span></article>
            <article><b>3.5</b><span>Consistent from the baseline, directs the ball, handles normal pressure.</span></article>
            <article><b>4.0+</b><span>Constructs points, owns a dependable second serve, punishes short balls.</span></article>
          </div>
        </div>
      </section>

      <section class="level-section">
        <div class="level-shell level-explain">
          <div>
            <p class="level-eyebrow">Why this works</p>
            <h2>We ask about tennis facts, not tennis confidence.</h2>
          </div>
          <div class="level-explain__list">
            <article>
              <h3>Playing background</h3>
              <p>League, team, clinic, and social tennis history gives the estimate its first guardrails.</p>
            </article>
            <article>
              <h3>Current habits</h3>
              <p>How often you play now matters more than the best version of your game from years ago.</p>
            </article>
            <article>
              <h3>Serve and rally shape</h3>
              <p>Second serve trust and directed rally balls separate most adult levels fastest.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="level-faq">
        <div class="level-shell">
          <h2>Common questions</h2>
          <dl>
            <dt>Is NTRP the same as UTR?</dt>
            <dd>No. NTRP runs in half steps and is the common language for US league play. UTR is match-result based and uses a wider numeric scale.</dd>

            <dt>Is a women's 4.0 the same as a men's 4.0?</dt>
            <dd>On paper the NTRP descriptions are identical. In practice the two scales are calibrated against different populations, because USTA ratings come out of league play that's separated by gender, and there's no official conversion between them. That's why we ask which you play before estimating rather than after.</dd>

            <dt>How accurate is this?</dt>
            <dd>Accurate enough to start in the right neighborhood. Match results are still the real test, so treat this as an estimate, not a lifetime label.</dd>

            <dt>Do I need an account?</dt>
            <dd>No. You only need an account if you want to save the result and use it for leagues, classes, coaches, or hitting partners.</dd>
          </dl>
        </div>
      </section>
    </main>
    <Footer wide />
  </div>

  <script is:inline define:vars={{ quizQuestions, areas, times, contactEmail }}>
    (() => {
      const RATING_MODEL_VERSION = 2;
      const quiz = document.getElementById("quiz");
      /**
       * Every scored answer needs an entry here. A missing one is not an error —
       * `weights[id]` is undefined and `|| 0` turns it into a zero — so the question
       * keeps being asked, keeps being shown as a reason for the result, and counts
       * for nothing. That is what happened to the rally answers from the day this
       * page shipped until 2026-09-14, and only came up because someone read the
       * table. A test now fails the build if any answer is missing from it.
       */
      const weights = {
        social: 0, lessons: 1, team: 2, college: 4,
        f3: 2, f2: 1, f1: 0, f0: -1,
        s0: 0, s1: 1, s2: 2, s3: 3,
        r0: 0, r1: 1, r2: 2, r3: 3,
      };
      /**
       * The comparison question is gone, and nothing was renormalised to compensate.
       *
       * It was circular — it asked for someone "whose level you know" and then never
       * asked what that level was, so beating a 3.0 and beating a 4.5 both scored
       * +0.4. It could not inform the estimate at any weight.
       *
       * Removing it needed no rebalancing because its neutral answers carried a
       * weight of 0: "we split" and "I'd rather skip this" contributed nothing, so
       * the base constant and the remaining weights already produce the identical
       * level. Across all 1024 answer combinations, 96 move — every one of them a
       * player who had answered "I usually beat them" or "they usually beat me",
       * which is the circular signal itself going away. Adding a compensating
       * constant would have re-rated everyone, including the 928 that do not move.
       */
      /**
       * Serve and rally are the two stroke questions and carry the same weight. They
       * did not before: with rally inert, serve at 1.2 was the entire stroke signal,
       * so a single answer about a second serve moved the estimate as much as both
       * strokes should together.
       *
       * Background stays the heaviest single question — it spans 0 to 4, so 4.4 of
       * range against 2.7 for either stroke — which is what the card claims when it
       * calls it the biggest clue. Frequency stays the modifier it reads as.
       *
       * SCALE. Turning rally on widens the raw range from 9.0 to 10.8, so leaving the
       * multiplier at 0.34 would have pushed everyone up half a level or more for no
       * better reason than an arithmetic side effect. 0.23 puts the strongest honest
       * set of answers — college player, playing three times a week, weapon serve,
       * constructs points — at 4.98, which is the 5.0 the top of this scale means.
       * The base stays 2.5, the floor of what this quiz will estimate.
       */
      const coefficients = { bg: 1.1, freq: 0.5, serve: 0.9, rally: 0.9 };
      const SCALE = 0.23;
      const clamps = {
        social: { ceiling: 3.5 },
        lessons: { ceiling: 4.0 },
        team: { floor: 3.0, ceiling: 4.5 },
        college: { floor: 4.0, ceiling: 5.0 },
      };
      const declared = { u30: 3.0, u35: 3.5, u40: 4.0, u45: 4.5, u50: 5.0 };

      // NTRP scales are calibrated against different populations. The stroke
      // descriptions in this quiz are absolute, so identical answers place
      // differently on the two scales.
      // UNVALIDATED — currently 0 while we gather data. The question is asked and
      // `pool` is captured on every completion, so nobody is mis-rated by a number
      // we have not checked. When the league data says otherwise, this line is the
      // only edit: the term is applied once, at the end of scoring, and nowhere else.
      const POOL_SHIFT = { m: 0, w: 0 };
      let answers = {};
      let index = 0;

      function toHalf(value) {
        return Math.round(value * 2) / 2;
      }

      /**
       * The one-line reason under the estimate. Four cases rather than two, because
       * the two stroke answers can disagree and the sentence has to survive that: a
       * player with a weapon serve and no rally shape is a different reading from one
       * who constructs points off a serve they only get in.
       */
      function explain(a) {
        const serve = a.serve === "s2" || a.serve === "s3";
        const rally = a.rally === "r2" || a.rally === "r3";
        if (serve && rally) {
          return "A second serve you trust and a rally you can direct are the two clearest markers at this level, and you have both.";
        }
        if (serve) {
          return "A second serve you trust under pressure is the clearest marker at this level; steadier rally shape is what would move you up half a level.";
        }
        if (rally) {
          return "Directing the ball in a rally puts you here; a second serve you trust under pressure is what would move you up half a level.";
        }
        return "Rally consistency and a reliable second serve are what move players up from here, and they tend to arrive in that order.";
      }

      function bandLabel(seed) {
        return seed >= 5 ? "5.0+" : `${seed.toFixed(1)}-${(seed + 0.5).toFixed(1)}`;
      }

      function score() {
        if (answers.bg === "starting") {
          return {
            seed: 2.0,
            band: "1.5-2.0",
            confidence: "Starting out",
            why: "That's a real level with a number, not a blank. What moves you up fastest is court time with someone showing you the basics.",
            declaredUsta: null,
          };
        }
        if (answers.bg === "usta") {
          const seed = declared[answers.usta] || 3.0;
          return {
            seed,
            band: seed >= 5 ? "5.0+" : seed.toFixed(1),
            confidence: "Self-declared",
            why: "You told us your USTA rating, which beats anything we could work out from five questions.",
            declaredUsta: seed,
          };
        }

        let raw = 0;
        Object.keys(coefficients).forEach((key) => {
          raw += (weights[answers[key]] || 0) * coefficients[key];
        });

        // Applied to the estimated path only. A declared USTA rating is already on the
        // right scale, and the beginner answer is a floor rather than an estimate.
        let seed = Math.max(2.5, Math.min(5.0, 2.5 + toHalf(raw * SCALE) + (POOL_SHIFT[answers.pool] || 0)));
        const clamp = clamps[answers.bg] || {};
        if (clamp.ceiling !== undefined && seed > clamp.ceiling) seed = clamp.ceiling;
        if (clamp.floor !== undefined && seed < clamp.floor) seed = clamp.floor;

        return {
          seed,
          band: bandLabel(seed),
          confidence: "Estimated",
          // Says what the answers actually were. The old pair claimed the rally answer
          // "backs it up" whichever way it had been answered — and it was contributing
          // nothing at the time, so for some players the sentence was false twice over.
          why: explain(answers),
          declaredUsta: null,
        };
      }

      /**
       * Jump to the "what rating do you play at" question.
       *
       * The index is looked up rather than written down. It used to be a literal 1,
       * correct only while the background question was first; inserting the pool
       * question ahead of it pointed the skip at the question it exists to skip.
       */
      function skipToUsta() {
        answers.bg = "usta";
        const target = activeQuestions().findIndex((question) => question.key === "usta");
        index = target === -1 ? index + 1 : target;
        renderQuestion();
      }

      function activeQuestions() {
        return quizQuestions.filter((question) => !question.branch || answers.bg === "usta");
      }

      function renderQuestion() {
        const questions = activeQuestions();
        if (answers.bg === "starting" || index >= questions.length) {
          renderResult();
          return;
        }

        const question = questions[index];
        const progress = Math.round(((index + 1) / questions.length) * 100);
        quiz.innerHTML = `
          <div class="qhead">
            <button class="qback" type="button" aria-label="Back"${index === 0 ? " disabled" : ""}>
              <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
            </button>
            <span class="qbar"><i style="width: ${progress}%"></i></span>
            <span class="qcount">${index + 1} of ${questions.length}</span>
          </div>
          <h2 class="qz-q" id="quiz-title" data-question-key="${question.key}">${question.prompt}</h2>
          <p class="qz-h">${question.hint}</p>
          <div class="qopts">
            ${question.options.map((option) => `
              <button class="qopt" type="button" data-option-id="${option.id}">
                <b>${option.label}</b>
                ${option.detail ? `<small>${option.detail}</small>` : ""}
              </button>
            `).join("")}
          </div>
          <div class="qskip"><button type="button" data-skip-to-usta>I already know my level</button></div>
        `;

        quiz.querySelector(".qback").addEventListener("click", () => {
          index = Math.max(0, index - 1);
          renderQuestion();
        });
        quiz.querySelectorAll("[data-option-id]").forEach((button) => {
          button.addEventListener("click", () => {
            answers[question.key] = button.dataset.optionId;
            index += 1;
            renderQuestion();
          });
        });
        quiz.querySelector("[data-skip-to-usta]").addEventListener("click", () => {
          skipToUsta();
        });
      }

      /**
       * The confidence we are handing on, as a stable slug rather than the sentence
       * we print. A consumer needs it to know whether to show a range at all: a
       * declared 4.0 has no uncertainty to display, and re-deriving that downstream
       * would mean guessing from information that is not in the URL.
       */
      const CONFIDENCE_SLUG = {
        "Estimated": "estimated",
        "Self-declared": "self_declared",
        "Starting out": "starting_out",
      };

      /**
       * What the player takes with them.
       *
       * `level` is the half step and nothing else — one format on every path,
       * declared and beginner exits included. It used to be the band: "3.5-4.0" on
       * one path, "4.0" on another, "1.5-2.0" on a third, which made every consumer
       * parse a string and decide which end was meant. Our divisions are 3.5 or 4.0,
       * never 3.5-4.0, so each of those guesses was a chance for the app and this
       * page to disagree about the same player.
       *
       * `band` is presentation. It stays on the screen and goes nowhere near a URL.
       *
       * Everything else is omitted when it was never answered, rather than sent
       * empty — an absent param says "not asked", an empty one says "asked and
       * blank", and they are different facts.
       */
      function appHref(settled) {
        const params = new URLSearchParams({ level: fmtLevel(settled.seed) });

        const confidence = CONFIDENCE_SLUG[settled.confidence];
        if (confidence) params.set("confidence", confidence);
        if (answers.feedback) params.set("feedback", answers.feedback);
        if (answers.pool) {
          params.set("pool", answers.pool);
          params.set("divisions", answers.pool === "w" ? "womens" : "mens");
        }
        if (answers.area) params.set("area", answers.area);
        if (answers.when) params.set("when", answers.when);

        params.set("src", "quiz");
        params.set("rating_model_version", String(RATING_MODEL_VERSION));
        return `https://app.thetennisplan.com/#/?${params.toString()}`;
      }

      /**
       * The estimate, as the player leaves it.
       *
       * `accepted` is what they settled on: our number until they nudge it, theirs
       * afterwards. It replaces the comparison question — anyone can say whether a
       * number sounds right about themselves, where "how do you do against someone
       * whose level you know" needed a second player's rating to mean anything.
       *
       * The answer NEVER moves the score on its own. It is recorded, and the only
       * thing that changes the level is the player explicitly taking the offered
       * half step — at which point it stops being our estimate and is labelled as
       * their claim.
       */
      let accepted = null;

      /**
       * What we keep between visits, and why it is worth keeping.
       *
       * The destination page being built next lives on this same origin, so it can
       * read this directly — someone who takes the quiz today and comes back next
       * week still has their level without carrying a URL around. If that page had
       * lived in the app it would be a different origin and nothing but the query
       * string would survive.
       *
       * Versioned twice over: STORE_VERSION for the shape, rating_model_version for
       * the rubric. A stored level from a different rubric is not this quiz's answer
       * and is discarded rather than shown back to someone as theirs.
       *
       * Every access is wrapped: localStorage throws outright in some private
       * browsing modes, and a quiz that cannot remember must still work.
       */
      const STORE_KEY = "ttp.levelQuiz";
      const STORE_VERSION = 1;

      function readStored() {
        try {
          const raw = window.localStorage.getItem(STORE_KEY);
          if (!raw) return null;
          const parsed = JSON.parse(raw);
          if (!parsed || parsed.v !== STORE_VERSION) return null;
          if (parsed.rating_model_version !== RATING_MODEL_VERSION) {
            window.localStorage.removeItem(STORE_KEY);
            return null;
          }
          if (typeof parsed.level !== "number") return null;
          return parsed;
        } catch {
          return null;
        }
      }

      function writeStored() {
        if (!accepted) return;
        try {
          window.localStorage.setItem(STORE_KEY, JSON.stringify({
            v: STORE_VERSION,
            rating_model_version: RATING_MODEL_VERSION,
            level: accepted.seed,
            confidence: CONFIDENCE_SLUG[accepted.confidence] || null,
            pool: answers.pool || null,
            feedback: answers.feedback || null,
            area: answers.area || null,
            when: answers.when || null,
            saved_at: new Date().toISOString(),
          }));
        } catch {
          // No store available. The run still works; it just will not be remembered.
        }
      }

      function clearStored() {
        try {
          window.localStorage.removeItem(STORE_KEY);
        } catch {
          // Nothing to do — see writeStored.
        }
      }

      function nudgeTarget(result) {
        if (answers.feedback === "low") return Math.min(5.5, result.seed + 0.5);
        if (answers.feedback === "high") return Math.max(1.5, result.seed - 0.5);
        return null;
      }

      function confirmBlock(result) {
        // Nothing to confirm for someone who told us their rating — they are the
        // source, so asking whether our number sounds right is asking them about
        // themselves twice.
        if (result.declaredUsta !== null) return "";

        if (!answers.feedback) {
          return `
            <div class="confirm">
              <p class="confirm__q" id="confirm-q">NTRP ${accepted.band} — does that sound about right?</p>
              <div class="confirm__opts" role="group" aria-labelledby="confirm-q">
                <button type="button" data-feedback="low">Lower than I expected</button>
                <button type="button" data-feedback="right">Sounds right</button>
                <button type="button" data-feedback="high">Higher than I expected</button>
              </div>
            </div>
          `;
        }

        // Answered and settled: they agreed, they took the half step, or they were
        // offered it and kept ours. All three are done; only an unanswered nudge
        // still has something to ask.
        if (answers.feedback === "right" || accepted.declared || answers.feedback.endsWith("_kept")) {
          return `<p class="confirm__done" role="status">Thanks — that helps us calibrate the quiz.</p>`;
        }

        const target = nudgeTarget(result);
        return `
          <div class="confirm">
            <p class="confirm__q" id="confirm-q">Want to set it to ${fmtLevel(target)} instead?</p>
            <div class="confirm__opts" role="group" aria-labelledby="confirm-q">
              <button type="button" data-adjust="${target}">Yes, ${fmtLevel(target)}</button>
              <button type="button" data-adjust="keep">No, keep ${fmtLevel(result.seed)}</button>
            </div>
          </div>
        `;
      }

      function fmtLevel(value) {
        return value.toFixed(1);
      }

      const labelOf = (list, id) => (list.find((entry) => entry.id === id) || {}).label;

      function chips(list, key) {
        return list.map((entry) => `
          <button type="button" class="chip${answers[key] === entry.id ? " chip--on" : ""}"
                  data-pick="${key}" data-value="${entry.id}"
                  aria-pressed="${answers[key] === entry.id ? "true" : "false"}">${entry.label}</button>
        `).join("");
      }

      /**
       * Place and time, shown once the confirmation is settled so only one thing is
       * ever asked at a time. Both optional: neither gates the button below them,
       * and tapping a chosen chip clears it.
       */
      function pickers() {
        if (!settledConfirmation()) return "";
        return `
          <div class="picks">
            <p class="picks__q" id="pick-area">Where do you play?</p>
            <div class="picks__row" role="group" aria-labelledby="pick-area">${chips(areas, "area")}</div>
            <p class="picks__q" id="pick-when">When, usually?</p>
            <div class="picks__row" role="group" aria-labelledby="pick-when">${chips(times, "when")}</div>
          </div>
        `;
      }

      function settledConfirmation() {
        return Boolean(answers.feedback) &&
          (answers.feedback === "right" || accepted.declared || answers.feedback.endsWith("_kept"));
      }

      /**
       * The panel under the result. Out of area gets its own, because the green one
       * promises players, classes and coaches we do not have outside West LA — and
       * promising them anyway is how a page like this loses the person it just
       * helped. Their level is theirs either way; the offer is the only thing that
       * changes.
       */
      function ctaPanel() {
        if (answers.area === "somewhere-else") {
          return `
            <div class="local local--away">
              <h3>We're West LA only, for now</h3>
              <p>Our leagues, classes and coaches are all in West Los Angeles at the moment. Tell us where you play and we'll let you know when we get there — your level is yours to keep either way.</p>
              <form class="away-form" name="level-quiz-waitlist" method="POST" data-netlify="true" netlify-honeypot="bot-field">
                <input type="hidden" name="form-name" value="level-quiz-waitlist" />
                <p class="away-form__hp"><label>Leave this empty <input name="bot-field" tabindex="-1" /></label></p>
                <input type="hidden" name="level" value="${fmtLevel(accepted.seed)}" />
                <label class="away-form__label" for="away-email">Your email</label>
                <div class="away-form__row">
                  <input id="away-email" name="email" type="email" required autocomplete="email" placeholder="you@example.com" />
                  <button class="btn solid" type="submit">Keep me posted</button>
                </div>
                <p class="away-form__note" data-away-note aria-live="polite"></p>
              </form>
            </div>
          `;
        }

        return `
          <div class="local">
            <h3>Playing in West LA?</h3>
            <p>Save your level and we'll show you players, classes, coaches, and league divisions that actually fit.</p>
            <a class="btn solid" href="${appHref(accepted)}">Find options at this level</a>
          </div>
        `;
      }

      /**
       * A resumed run has no answers to score — this visit never asked the questions.
       * The stored result is pinned so that re-renders (picking a neighbourhood, say)
       * keep showing it instead of scoring an empty answer set.
       */
      let pinned = null;

      function renderStoredResult() {
        pinned = {
          seed: accepted.seed,
          band: accepted.band,
          confidence: accepted.confidence,
          why: "This is the level you landed on last time. Take it again if your game has moved.",
          declaredUsta: accepted.declared ? accepted.seed : null,
        };
        renderResult();
      }

      function renderResult() {
        const result = pinned || score();
        if (!accepted) {
          accepted = { seed: result.seed, band: result.band, confidence: result.confidence, declared: false };
        }

        const payload = result.declaredUsta === null
          ? {
              self_rated_seed: accepted.seed,
              // Their claim once they have moved it, ours until then.
              self_rating_source: accepted.declared ? "self_declared" : "self_assessed",
              rating_quiz_answers: answers,
              rating_model_version: RATING_MODEL_VERSION,
            }
          : { usta_rating: result.declaredUsta };

        quiz.innerHTML = `
          <div class="res">
            <p class="lead">Based on your answers, you look like</p>
            <p class="band">NTRP ${accepted.band}</p>
            <span class="conf">${accepted.confidence}</span>
            <p class="why">${result.why}</p>
            ${confirmBlock(result)}
            ${pickers()}
            ${ctaPanel()}
            <details class="save-preview">
              <summary>What the app saves if you sign in</summary>
              <pre>${JSON.stringify(payload, null, 2)}</pre>
            </details>
            <p class="again"><button class="level-reset" type="button">Take it again</button></p>
          </div>
        `;

        quiz.querySelectorAll("[data-feedback]").forEach((button) => {
          button.addEventListener("click", () => {
            // Recorded, not applied. When the completion event ships, this rides
            // along with level, confidence and pool — it is the calibration signal.
            answers.feedback = button.dataset.feedback;
            renderResult();
          });
        });

        quiz.querySelectorAll("[data-adjust]").forEach((button) => {
          button.addEventListener("click", () => {
            if (button.dataset.adjust !== "keep") {
              const seed = Number(button.dataset.adjust);
              accepted = { seed, band: bandLabel(seed), confidence: "Self-declared", declared: true };
            } else {
              accepted = { ...accepted, declared: false };
              answers.feedback = answers.feedback === "low" ? "low_kept" : "high_kept";
            }
            renderResult();
          });
        });

        quiz.querySelectorAll("[data-pick]").forEach((button) => {
          button.addEventListener("click", () => {
            const key = button.dataset.pick;
            // Tapping the chosen one clears it: these are optional, and an answer you
            // cannot take back is not optional.
            answers[key] = answers[key] === button.dataset.value ? undefined : button.dataset.value;
            renderResult();
          });
        });

        const awayForm = quiz.querySelector(".away-form");
        if (awayForm) {
          awayForm.addEventListener("submit", async (event) => {
            event.preventDefault();
            const note = awayForm.querySelector("[data-away-note]");
            const email = awayForm.querySelector("#away-email").value.trim();
            if (!email) return;
            try {
              const response = await fetch("/", {
                method: "POST",
                headers: { "Content-Type": "application/x-www-form-urlencoded" },
                body: new URLSearchParams(new FormData(awayForm)).toString(),
              });
              if (!response.ok) throw new Error(String(response.status));
              note.textContent = "Thanks — we'll be in touch when we reach you.";
            } catch {
              // Never swallow it. If the post fails, hand them a way to reach us that
              // cannot fail, with the details already filled in.
              const subject = encodeURIComponent("Tennis Plan — let me know when you reach my area");
              const body = encodeURIComponent(`I came out at NTRP ${fmtLevel(accepted.seed)} on the level quiz.\n\nEmail: ${email}\n\nI play in: `);
              note.innerHTML = `That didn't send. <a href="mailto:${contactEmail}?subject=${subject}&body=${body}">Email us instead</a> and we'll add you.`;
            }
          });
        }

        writeStored();

        quiz.querySelector(".level-reset").addEventListener("click", () => {
          answers = {};
          accepted = null;
          pinned = null;
          index = 0;
          clearStored();
          renderQuestion();
        });
      }

      /**
       * A returning visitor is offered what they got last time instead of five
       * questions they have already answered. Retaking is one tap and sits right
       * next to it — a resume that hides the way back is worse than no resume.
       */
      function renderResume(stored) {
        const band = stored.confidence === "self_declared"
          ? fmtLevel(stored.level)
          : stored.confidence === "starting_out"
            ? "1.5-2.0"
            : bandLabel(stored.level);

        quiz.innerHTML = `
          <div class="resume">
            <p class="lead">Last time you came out at</p>
            <p class="band">NTRP ${band}</p>
            <p class="why">Still right? Pick up where you left off, or start again from the first question.</p>
            <div class="confirm__opts" role="group">
              <button class="btn solid" type="button" data-resume>Yes, that's still me</button>
              <button type="button" data-restart>Take it again</button>
            </div>
          </div>
        `;

        quiz.querySelector("[data-resume]").addEventListener("click", () => {
          answers = {
            pool: stored.pool || undefined,
            feedback: stored.feedback || undefined,
            area: stored.area || undefined,
            when: stored.when || undefined,
          };
          accepted = {
            seed: stored.level,
            band,
            confidence: stored.confidence === "self_declared"
              ? "Self-declared"
              : stored.confidence === "starting_out"
                ? "Starting out"
                : "Estimated",
            declared: stored.confidence === "self_declared",
          };
          // Rendered from the stored answer, so the scoring is not re-run over
          // questions this visit never asked.
          renderStoredResult();
        });

        quiz.querySelector("[data-restart]").addEventListener("click", () => {
          answers = {};
          accepted = null;
          pinned = null;
          index = 0;
          clearStored();
          renderQuestion();
        });
      }

      const stored = readStored();
      if (stored) renderResume(stored);

      quiz.addEventListener("click", (event) => {
        if (event.target.closest("[data-skip-to-usta]")) {
          skipToUsta();
          return;
        }
        const button = event.target.closest("[data-option-id]");
        if (!button) return;
        const question = activeQuestions()[index];
        if (!question) return;
        answers[question.key] = button.dataset.optionId;
        index += 1;
        renderQuestion();
      }, { once: true });
    })();
  </script>
</BaseLayout>

