---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { ratingQuizQuestions } from "../../../../src/features/ratingQuiz/ratingQuizModel";

const title = "What's My Tennis Level? Free NTRP Rating Quiz | The Tennis Plan";
// No question count in the copy: the paths are different lengths — the beginner
// answer exits early, declaring a USTA rating short-circuits the scoring — so any
// fixed number is wrong on most of them. "About a minute" is true on all.
const description =
  "Get an honest NTRP estimate in about a minute. No account, no email needed.";

// The questions and scoring are shared with the app's /rating-quiz and the group
// lesson level check, so a player gets the same level wherever they take it. The
// module has no imports, so pulling it in from the app's src/ adds nothing to this build.
const quizQuestions = ratingQuizQuestions;

/**
 * The served first card shows a count, and it has to agree with what the script
 * computes once it takes over. Derived rather than written out: "1 of 5" was left
 * behind when this question set changed, and the page shipped saying five.
 *
 * The default path is every non-branching question — declaring a USTA rating is
 * the only thing that opens the branch.
 */
const defaultPathLength = quizQuestions.filter((question) => !question.branch).length;
const initialProgress = Math.round((1 / defaultPathLength) * 100);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Is NTRP the same as UTR?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "No. NTRP runs 1.0 to 7.0 in half steps and is the standard for US league play. UTR runs 1 to 16.5 and is calculated from match results.",
      },
    },
    {
      "@type": "Question",
      name: "Is a women's 4.0 the same as a men's 4.0?",
      acceptedAnswer: {
        "@type": "Answer",
        // Identical to the visible answer in the FAQ below — marked-up text that does
        // not match what the page shows is a structured-data violation, not a nicety.
        text: "On paper the NTRP descriptions are identical. In practice the two scales are calibrated against different populations, because USTA ratings come out of league play that's separated by gender, and there's no official conversion between them. That's why we ask which you play before estimating rather than after.",
      },
    },
    {
      "@type": "Question",
      name: "How accurate is a tennis self-rating?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Less accurate than most players expect, particularly between 3.0 and 4.0. Asking about playing history and results is more reliable than asking players to pick a flattering description.",
      },
    },
    {
      "@type": "Question",
      name: "Do I need an account?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "No account is needed to take the quiz or see the result. You only need one if you want to save the level and use it in The Tennis Plan app.",
      },
    },
  ],
};
---

<BaseLayout {title} {description} canonicalPath="/what-is-my-tennis-level" schema={faqSchema}>
  <div class="level-page">
    <Header />
    <main id="main">
      <section class="level-hero">
        <div class="level-hero__image" aria-hidden="true"></div>
        <div class="level-shell level-hero__inner">
          <div class="level-copy">
            <p class="level-eyebrow">Free NTRP quiz</p>
            <h1>What's my tennis level?</h1>
            <p>
              About a minute, no account. Get a practical NTRP estimate you can use to
              choose better matches, classes, leagues, and coaches.
            </p>
            <div class="level-proof" aria-label="Quiz promises">
              <span>About a minute</span>
              <span>No email</span>
              <span>Half-level band</span>
            </div>
          </div>

          <section class="level-quiz quiz" id="quiz" aria-labelledby="quiz-title">
            <div class="qhead">
              <button class="qback" type="button" aria-label="Back" disabled>
                <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
              </button>
              <span class="qbar"><i style={`width: ${initialProgress}%`}></i></span>
              <span class="qcount">1 of {defaultPathLength}</span>
            </div>
            <h2 class="qz-q" id="quiz-title" data-question-key={quizQuestions[0].key}>{quizQuestions[0].prompt}</h2>
            <p class="qz-h">{quizQuestions[0].hint}</p>
            <div class="qopts">
              {quizQuestions[0].options.map((option) => (
                <button class="qopt" type="button" data-option-id={option.id}>
                  <b>{option.label}</b>
                  {option.detail && <small>{option.detail}</small>}
                </button>
              ))}
            </div>
            <div class="qskip"><button type="button" data-skip-to-usta>I already know my level</button></div>
          </section>
        </div>
      </section>

      <section class="level-section level-section--levels">
        <div class="level-shell">
          <div class="level-section__head">
            <p class="level-eyebrow">NTRP, briefly</p>
            <h2>The adult rec levels most players mean</h2>
          </div>
          <div class="level-grid">
            <article><b>2.0-2.5</b><span>Newer player building rally control and serve basics.</span></article>
            <article><b>3.0</b><span>Can rally and start points reliably, but pace and placement vary.</span></article>
            <article><b>3.5</b><span>Consistent from the baseline, directs the ball, handles normal pressure.</span></article>
            <article><b>4.0+</b><span>Constructs points, owns a dependable second serve, punishes short balls.</span></article>
          </div>
        </div>
      </section>

      <section class="level-section">
        <div class="level-shell level-explain">
          <div>
            <p class="level-eyebrow">Why this works</p>
            <h2>We ask about tennis facts, not tennis confidence.</h2>
          </div>
          <div class="level-explain__list">
            <article>
              <h3>Playing background</h3>
              <p>League, team, clinic, and social tennis history gives the estimate its first guardrails.</p>
            </article>
            <article>
              <h3>Current habits</h3>
              <p>How often you play now matters more than the best version of your game from years ago.</p>
            </article>
            <article>
              <h3>Serve and rally shape</h3>
              <p>Second serve trust and directed rally balls separate most adult levels fastest.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="level-faq">
        <div class="level-shell">
          <h2>Common questions</h2>
          <dl>
            <dt>Is NTRP the same as UTR?</dt>
            <dd>No. NTRP runs in half steps and is the common language for US league play. UTR is match-result based and uses a wider numeric scale.</dd>

            <dt>Is a women's 4.0 the same as a men's 4.0?</dt>
            <dd>On paper the NTRP descriptions are identical. In practice the two scales are calibrated against different populations, because USTA ratings come out of league play that's separated by gender, and there's no official conversion between them. That's why we ask which you play before estimating rather than after.</dd>

            <dt>How accurate is this?</dt>
            <dd>Accurate enough to start in the right neighborhood. Match results are still the real test, so treat this as an estimate, not a lifetime label.</dd>

            <dt>Do I need an account?</dt>
            <dd>No. You only need an account if you want to save the result and use it for leagues, classes, coaches, or hitting partners.</dd>
          </dl>
        </div>
      </section>
    </main>
    <Footer wide />
  </div>

  <script>
    // The page's half of the quiz: rendering, the "does that sound right?" nudge and the
    // hand-off to the app. The questions, weights and scoring are the shared model in
    // src/features/ratingQuiz/ratingQuizModel.ts, the same one the app's quizzes use.
    import {
      RATING_MODEL_VERSION,
      activeQuestionIndex,
      activeRatingQuizQuestions,
      buildRatingQuizPayload,
      nudgeTarget,
      scoreRatingQuiz,
      settleEstimate,
      takeNudge,
      type RatingQuizAnswers,
      type RatingQuizPayload,
      type RatingQuizResult,
      type SettledLevel,
    } from "../../../../src/features/ratingQuiz/ratingQuizModel";
    import { APP_SAVE_LEVEL_URL, loginHref } from "../lib/appLinks";

    const quiz = document.getElementById("quiz");
    const appLoginUrl = loginHref();

    if (quiz) {
      let answers: RatingQuizAnswers = {};
      let index = 0;

      /**
       * The estimate, as the player leaves it.
       *
       * `accepted` is what they settled on: our number until they nudge it, theirs
       * afterwards. Anyone can say whether a number sounds right about themselves, where
       * "how do you do against someone whose level you know" needed a second player's
       * rating to mean anything.
       *
       * The answer NEVER moves the score on its own. It is recorded, and the only thing
       * that changes the level is the player explicitly taking the offered half step —
       * at which point it stops being our estimate and is labelled as their claim.
       */
      let accepted: SettledLevel | null = null;

      /** Jump to the "what rating do you play at" question, found by key. */
      const skipToUsta = () => {
        answers.bg = "usta";
        const target = activeQuestionIndex(answers, "usta");
        index = target === -1 ? index + 1 : target;
        renderQuestion();
      };

      const renderQuestion = () => {
        const questions = activeRatingQuizQuestions(answers);
        if (answers.bg === "starting" || index >= questions.length) {
          renderResult();
          return;
        }

        const question = questions[index];
        const progress = Math.round(((index + 1) / questions.length) * 100);
        quiz.innerHTML = `
          <div class="qhead">
            <button class="qback" type="button" aria-label="Back"${index === 0 ? " disabled" : ""}>
              <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
            </button>
            <span class="qbar"><i style="width: ${progress}%"></i></span>
            <span class="qcount">${index + 1} of ${questions.length}</span>
          </div>
          <h2 class="qz-q" id="quiz-title" data-question-key="${question.key}">${question.prompt}</h2>
          <p class="qz-h">${question.hint}</p>
          <div class="qopts">
            ${question.options.map((option) => `
              <button class="qopt" type="button" data-option-id="${option.id}">
                <b>${option.label}</b>
                ${option.detail ? `<small>${option.detail}</small>` : ""}
              </button>
            `).join("")}
          </div>
          <div class="qskip"><button type="button" data-skip-to-usta>I already know my level</button></div>
        `;

        quiz.querySelector(".qback")?.addEventListener("click", () => {
          index = Math.max(0, index - 1);
          renderQuestion();
        });
        quiz.querySelectorAll<HTMLButtonElement>("[data-option-id]").forEach((button) => {
          button.addEventListener("click", () => {
            answers[question.key] = button.dataset.optionId;
            index += 1;
            renderQuestion();
          });
        });
        quiz.querySelector("[data-skip-to-usta]")?.addEventListener("click", () => {
          skipToUsta();
        });
      };

      const appHref = (settled: SettledLevel, payload: RatingQuizPayload) => {
        const params = new URLSearchParams({
          level: settled.band,
          src: "quiz",
          rating_model_version: String(RATING_MODEL_VERSION),
          // The result itself, so "Save my level" on /whats-on can hand it to the app.
          quiz: JSON.stringify(payload),
        });
        // Which division this routes to. Nothing reads it yet; it costs nothing to
        // send and the alternative is re-asking later. Omitted rather than guessed
        // when the question was not reached.
        if (answers.pool) params.set("divisions", answers.pool === "w" ? "womens" : "mens");
        return `/whats-on?${params.toString()}`;
      };

      // Every sign-in link on the page (the header's included) carries the current
      // result to the app, which saves it if the account has no level yet. With no
      // result they go back to a plain sign-in.
      const pointAppLinksAt = (payload: RatingQuizPayload | null) => {
        const href = payload
          ? `${APP_SAVE_LEVEL_URL}?quiz=${encodeURIComponent(JSON.stringify(payload))}`
          : null;
        document.querySelectorAll<HTMLAnchorElement>(`a[href^="${appLoginUrl}"], a[data-app-login]`).forEach((link) => {
          if (!link.dataset.appLogin) link.dataset.appLogin = link.getAttribute("href") ?? "";
          link.setAttribute("href", href || link.dataset.appLogin);
        });
      };

      const fmtLevel = (value: number) => value.toFixed(1);

      const confirmBlock = (result: RatingQuizResult, settled: SettledLevel) => {
        // Nothing to confirm for someone who told us their rating — they are the
        // source, so asking whether our number sounds right is asking them about
        // themselves twice.
        if (result.declaredUsta !== null) return "";

        if (!answers.feedback) {
          return `
            <div class="confirm">
              <p class="confirm__q" id="confirm-q">NTRP ${settled.band} — does that sound about right?</p>
              <div class="confirm__opts" role="group" aria-labelledby="confirm-q">
                <button type="button" data-feedback="low">Lower than I expected</button>
                <button type="button" data-feedback="right">Sounds right</button>
                <button type="button" data-feedback="high">Higher than I expected</button>
              </div>
            </div>
          `;
        }

        // Answered and settled: they agreed, they took the half step, they were offered
        // it and kept ours, or there is no step the app could save. Only an unanswered
        // offer still has something to ask.
        const target = nudgeTarget(result.seed, answers.feedback);
        if (answers.feedback === "right" || settled.declared || answers.feedback.endsWith("_kept") || target === null) {
          return `<p class="confirm__done" role="status">Thanks — that helps us calibrate the quiz.</p>`;
        }

        return `
          <div class="confirm">
            <p class="confirm__q" id="confirm-q">Want to set it to ${fmtLevel(target)} instead?</p>
            <div class="confirm__opts" role="group" aria-labelledby="confirm-q">
              <button type="button" data-adjust="${target}">Yes, ${fmtLevel(target)}</button>
              <button type="button" data-adjust="keep">No, keep ${fmtLevel(result.seed)}</button>
            </div>
          </div>
        `;
      };

      const renderResult = () => {
        const result = scoreRatingQuiz(answers);
        const settled = accepted ?? settleEstimate(result);
        accepted = settled;
        const payload = buildRatingQuizPayload(answers, settled);

        quiz.innerHTML = `
          <div class="res">
            <p class="lead">Based on your answers, you look like</p>
            <p class="band">NTRP ${settled.band}</p>
            <span class="conf">${settled.confidence}</span>
            <p class="why">${result.why}</p>
            ${confirmBlock(result, settled)}
            <div class="local">
              <h3>Playing in West LA?</h3>
              <p>Save your level and we'll show you players, classes, coaches, and league divisions that actually fit.</p>
              <a class="btn solid" href="${appHref(settled, payload)}">Find options at this level</a>
            </div>
            <details class="save-preview">
              <summary>What the app saves if you sign in</summary>
              <pre>${JSON.stringify(payload, null, 2)}</pre>
            </details>
            <p class="again"><button class="level-reset" type="button">Take it again</button></p>
          </div>
        `;

        pointAppLinksAt(payload);

        quiz.querySelectorAll<HTMLButtonElement>("[data-feedback]").forEach((button) => {
          button.addEventListener("click", () => {
            // Recorded, not applied. When the completion event ships, this rides along
            // with level, confidence and pool — it is the calibration signal.
            answers.feedback = button.dataset.feedback;
            renderResult();
          });
        });

        quiz.querySelectorAll<HTMLButtonElement>("[data-adjust]").forEach((button) => {
          button.addEventListener("click", () => {
            if (button.dataset.adjust !== "keep") {
              accepted = takeNudge(Number(button.dataset.adjust));
            } else {
              accepted = settleEstimate(result);
              answers.feedback = answers.feedback === "low" ? "low_kept" : "high_kept";
            }
            renderResult();
          });
        });

        quiz.querySelector(".level-reset")?.addEventListener("click", () => {
          answers = {};
          accepted = null;
          index = 0;
          pointAppLinksAt(null);
          renderQuestion();
        });
      };

      // The first card is served as HTML so it shows before the script runs; its
      // options are picked up here once, then renderQuestion owns the card.
      quiz.addEventListener("click", (event) => {
        const target = event.target as HTMLElement;
        if (target.closest("[data-skip-to-usta]")) {
          skipToUsta();
          return;
        }
        const button = target.closest<HTMLElement>("[data-option-id]");
        if (!button) return;
        const question = activeRatingQuizQuestions(answers)[index];
        if (!question) return;
        answers[question.key] = button.dataset.optionId;
        index += 1;
        renderQuestion();
      }, { once: true });
    }
  </script>
</BaseLayout>

<style>
  .level-page {
    --level-ink: #111827;
    --level-muted: #566074;
    --level-line: #e4e7ec;
    --level-purple: #7c5cf5;
    --level-purple-dark: #5b3ad4;
    --level-green: #15794a;
    --level-lime: #9be24e;
    --level-wash: #f7f8fb;
    background: #fff;
    color: var(--level-muted);
  }

  .level-shell {
    width: min(1180px, 100%);
    margin-inline: auto;
    padding-inline: clamp(20px, 4vw, 64px);
  }

  .level-hero {
    position: relative;
    overflow: hidden;
    background: #111827;
  }

  .level-hero__image {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgb(17 24 39 / 92%) 0%, rgb(17 24 39 / 82%) 38%, rgb(17 24 39 / 48%) 66%, rgb(17 24 39 / 22%) 100%),
      url("/images/landing/match-nights.jpg") center / cover no-repeat;
  }

  .level-hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, .95fr) minmax(360px, .72fr);
    gap: clamp(28px, 6vw, 72px);
    align-items: center;
    min-height: calc(100svh - 64px);
    padding-block: clamp(40px, 7vw, 90px);
  }

  .level-copy {
    max-width: 650px;
    color: #fff;
  }

  .level-eyebrow {
    margin: 0 0 14px;
    color: var(--level-lime);
    font-size: .8rem;
    font-weight: 800;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .level-copy h1 {
    margin: 0;
    color: #fff;
    font-size: clamp(2.65rem, 6vw, 5rem);
    line-height: .98;
    letter-spacing: 0;
  }

  .level-copy > p:not(.level-eyebrow) {
    max-width: 58ch;
    margin: 20px 0 0;
    color: rgb(255 255 255 / 88%);
    font-size: clamp(1.05rem, 2vw, 1.22rem);
    line-height: 1.62;
  }

  .level-proof {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 26px;
  }

  .level-proof span {
    border: 1px solid rgb(255 255 255 / 24%);
    border-radius: 999px;
    padding: 8px 13px;
    color: #fff;
    background: rgb(255 255 255 / 12%);
    font-size: .88rem;
    font-weight: 700;
  }

  .level-quiz {
    border: 1px solid rgb(255 255 255 / 30%);
    border-radius: 18px;
    padding: 26px;
    background: #fff;
    color: var(--level-ink);
    box-shadow: 0 30px 70px rgb(0 0 0 / 28%);
    min-height: 340px;
    display: flex;
    flex-direction: column;
  }

  :global(.qhead) {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
  }

  :global(.qback) {
    width: 24px;
    height: 24px;
    border: 0;
    padding: 2px;
    color: var(--level-muted);
    background: none;
    font: inherit;
    line-height: 0;
    cursor: pointer;
  }

  :global(.qback:disabled) {
    opacity: .42;
    cursor: default;
  }

  :global(.qbar) {
    flex: 1;
    height: 5px;
    overflow: hidden;
    border-radius: 999px;
    background: var(--level-line);
  }

  :global(.qbar i) {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--level-purple);
    transition: width .2s ease;
  }

  :global(.qcount) {
    color: var(--level-muted);
    font-size: .78rem;
    font-weight: 700;
    white-space: nowrap;
  }

  :global(.qz-q) {
    margin: 0;
    color: var(--level-ink);
    font-size: 1.22rem;
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: 0;
  }

  :global(.qz-h) {
    margin: 6px 0 0;
    color: var(--level-muted);
    font-size: .86rem;
    line-height: 1.45;
  }

  :global(.qopts) {
    display: grid;
    gap: 9px;
    margin-top: 16px;
  }

  :global(.qopt) {
    width: 100%;
    border: 1px solid var(--level-line);
    border-radius: 12px;
    padding: 12px 14px;
    color: var(--level-ink);
    background: #fff;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  :global(.qopt:hover) {
    border-color: var(--level-purple);
    background: #f1edfe;
  }

  :global(.qopt b) {
    display: block;
    font-size: .94rem;
    font-weight: 700;
  }

  :global(.qopt small) {
    display: block;
    margin-top: 2px;
    color: var(--level-muted);
    font-size: .8rem;
    line-height: 1.45;
  }

  :global(.qskip) {
    margin-top: 16px;
    text-align: center;
  }

  :global(.qskip button),
  :global(.res .again button) {
    border: 0;
    padding: 0;
    color: var(--level-purple-dark);
    background: none;
    font: inherit;
    font-size: .83rem;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  :global(.res) {
    margin: auto 0;
    text-align: center;
  }

  :global(.res .lead) {
    margin: 0;
    color: var(--level-muted);
    font-size: .86rem;
  }

  :global(.res .band) {
    margin: 4px 0 8px;
    color: var(--level-ink);
    font-size: 2.6rem;
    font-weight: 800;
    line-height: 1;
  }

  :global(.res .conf) {
    display: inline-block;
    border-radius: 999px;
    padding: 5px 13px;
    color: #8a5a0b;
    background: #fdf3e3;
    font-size: .78rem;
    font-weight: 800;
  }

  :global(.res .why) {
    margin: 16px 0 0;
    color: var(--level-muted);
    font-size: .9rem;
    line-height: 1.55;
  }

  /* The confirmation that replaced the comparison question. Styled off the same
     tokens as the quiz options so the result screen does not introduce a new
     button language. */
  :global(.confirm) {
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px solid var(--level-line);
  }

  :global(.confirm__q) {
    margin: 0 0 10px;
    color: var(--level-ink);
    font-size: .92rem;
    font-weight: 700;
  }

  :global(.confirm__opts) {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  :global(.confirm__opts button) {
    flex: 1 1 auto;
    border: 1px solid var(--level-line);
    border-radius: 999px;
    padding: 9px 14px;
    color: var(--level-ink);
    background: #fff;
    font: inherit;
    font-size: .86rem;
    cursor: pointer;
  }

  :global(.confirm__opts button:hover) {
    border-color: var(--level-purple);
    color: var(--level-purple-dark);
  }

  /* The page sets no focus styles anywhere, so these keep the browser's ring
     rather than replacing it with something less visible. */
  :global(.confirm__opts button:focus-visible) {
    outline: 2px solid var(--level-purple);
    outline-offset: 2px;
  }

  :global(.confirm__done) {
    margin: 18px 0 0;
